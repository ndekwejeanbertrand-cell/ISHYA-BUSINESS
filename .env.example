# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Meta WhatsApp Cloud API credentials (Phase 4)
# Leave unset if using direct wa.me customer contact links only.
WHATSAPP_VERIFY_TOKEN="MY_WHATSAPP_VERIFY_TOKEN"
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION=""
WHATSAPP_APP_SECRET="MY_WHATSAPP_APP_SECRET"

# Server-only Google service account JSON (store as a hosting secret; never commit real credentials).
# Required by the durable appointment reminder worker when enabled.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Random secret used by the hosting scheduler to authenticate reminder-worker requests.
APPOINTMENT_REMINDER_CRON_SECRET=""

# Meta-approved appointment reminder template. Its body must use four ordered variables:\n# {{1}} customer name, {{2}} business name, {{3}} service name, {{4}} appointment date/time.\n# Confirm the template is approved and matches this contract in WhatsApp Manager.
WHATSAPP_REMINDER_TEMPLATE_NAME=""
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE="en"

# IntouchSMS HTTP API credentials (server-only hosting secrets; never commit real values).
# The Sender ID must be provisioned/approved by IntouchSMS before live sending.
INTOUCH_SMS_USERNAME=""
INTOUCH_SMS_PASSWORD=""
INTOUCH_SMS_SENDER_ID="ISHYA"
